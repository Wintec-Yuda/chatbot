# Wajib — ambil di https://console.groq.com/keys
GROQ_API_KEY=

# Opsional — ganti model tanpa ubah kode (cek daftar model aktif di console Groq)
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_MAIN=openai/gpt-oss-120b

# Kosongkan saat develop lokal (otomatis pakai file:local.db).
# Untuk Vercel: buat DB di https://turso.tech lalu isi keduanya.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Batas pesan per IP per 10 menit
RATE_LIMIT_PER_10MIN=20

HF_TOKEN=
